+++ b/tests/test_invoices.py
@@ -0,0 +1,8 @@
+def test_logged_in_user_gets_invoice(client, login, invoice):
+    login(invoice.customer_id)
+    assert client.get(f"/invoices/{invoice.id}").status_code == 200
+
+
+def test_unknown_invoice_is_404(client, login):
+    login(1)
+    assert client.get("/invoices/9999").status_code == 404
