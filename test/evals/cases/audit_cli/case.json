{
  "prompt": "Audit this repo: the files in the current directory. Report it as an audit.",
  "first_line": "^Verdict:",
  "must_fail": [
    {"id": "svc-cli-exit-codes-and-streams", "alt": "(?i)exit(s)? 0|exit code|stderr"}
  ],
  "must_contain": [
    "(?i)N/A:"
  ],
  "must_not_contain": [
    "(?i)(FAIL|PASS)[^\\n]*(fn-aria|fn-dialog|fn-focus-indicator|fn-heading|fn-form-control|fn-img-alt|svc-csrf|svc-cors|fn-jwt)"
  ]
}
