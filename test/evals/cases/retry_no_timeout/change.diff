Pull request: Sync invoices to the billing provider when an order is paid.

diff --git a/sync/provider.py b/sync/provider.py
new file mode 100644
--- /dev/null
+++ b/sync/provider.py
@@ -0,0 +1,22 @@
+import requests
+
+PROVIDER_URL = "https://billing.example.com/v2/invoices"
+
+
+def push_invoice(invoice: dict, token: str) -> dict:
+    """Send one invoice to the provider and return its record."""
+    while True:
+        try:
+            resp = requests.post(
+                PROVIDER_URL,
+                json=invoice,
+                headers={"Authorization": f"Bearer {token}"},
+            )
+            resp.raise_for_status()
+            return resp.json()
+        except Exception:
+            continue
