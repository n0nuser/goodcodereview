+from unittest import mock
+
+from sync.provider import push_invoice
+
+
+def test_push_invoice_returns_provider_record():
+    resp = mock.Mock()
+    resp.json.return_value = {"id": "inv_1"}
+    with mock.patch("sync.provider.requests.post", return_value=resp):
+        assert push_invoice({"total": 10}, "t") == {"id": "inv_1"}
